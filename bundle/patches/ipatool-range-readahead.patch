+func TestPartialZipReadaheadReadsVersionMetadataInAFewRequests(t *testing.T) {
+	for _, test := range []struct {
+		name  string
+		files int
+	}{
+		{name: "thousands of files", files: 5000},
+		{name: "a central directory bigger than the tail", files: 40000},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			ipa, directory := readaheadTestIPA(t, test.files)
+			server := newRangeServer(t, ipa, nil)
+
+			metadata, err := (&appstore{httpClient: newDownloadTestClient()}).readVersionMetadataFromIPA(server.URL)
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			if metadata.DisplayVersion != "4.5.6" || !metadata.ReleaseDate.Equal(time.Date(2024, 4, 2, 12, 0, 0, 0, time.UTC)) {
+				t.Fatalf("metadata = %+v", metadata)
+			}
+
+			// The size, the tail, and the block the Info.plist is in (the
+			// first); then a block per MiB of directory beyond the tail, plus
+			// one for the block the directory starts in.
+			limit := int64(3)
+			if beyond := directory - rangeTailSize; beyond > 0 {
+				limit += (beyond+rangeBlockSize-1)/rangeBlockSize + 1
+			}
+
+			requests := server.requests.Load()
+			t.Logf("%d files, a %d-byte IPA with a %d-byte central directory: %d requests, %d bytes sent",
+				test.files, len(ipa), directory, requests, server.sent.Load())
+
+			if requests > limit {
+				t.Fatalf("%d requests, more than %d", requests, limit)
+			}
+		})
+	}
+}
