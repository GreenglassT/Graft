+
+// rangeServer serves data as Apple's CDN serves an IPA, a GET with a Range
+// header answered 206 with that range, and counts the requests and the bytes
+// it sent. misbehave, when set, may answer request n (from 1) itself.
+type rangeServer struct {
+	*httptest.Server
+	requests atomic.Int64
+	sent     atomic.Int64
+}
+
+func newRangeServer(t *testing.T, data []byte, misbehave func(n int64, w http.ResponseWriter, r *http.Request) bool) *rangeServer {
+	t.Helper()
+
+	server := &rangeServer{}
+	server.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		n := server.requests.Add(1)
+
+		if r.Header.Get("Accept-Encoding") != "identity" {
+			t.Errorf("request %d: Accept-Encoding = %q", n, r.Header.Get("Accept-Encoding"))
+		}
+
+		if misbehave != nil && misbehave(n, w, r) {
+			return
+		}
+
+		start, end, err := testRangeBounds(r.Header.Get("Range"), len(data))
+		if err != nil {
+			t.Errorf("request %d: %v", n, err)
+			w.WriteHeader(http.StatusRequestedRangeNotSatisfiable)
+
+			return
+		}
+
+		w.Header().Set("Content-Range", fmt.Sprintf("bytes %d-%d/%d", start, end, len(data)))
+		w.Header().Set("Content-Length", strconv.Itoa(end-start+1))
+		w.WriteHeader(http.StatusPartialContent)
+
+		sent, _ := w.Write(data[start : end+1])
+		server.sent.Add(int64(sent))
+	}))
+	t.Cleanup(server.Close)
+
+	return server
+}
+
+// stall answers nothing until the client gives up.
+func stall(_ http.ResponseWriter, r *http.Request) {
+	select {
+	case <-r.Context().Done():
+	case <-time.After(10 * time.Second):
+	}
+}
+
+func randomBytes(size int64, seed int64) []byte {
+	data := make([]byte, size)
+	_, _ = rand.New(rand.NewSource(seed)).Read(data)
+
+	return data
+}
+
+func withRangeRequestTimeout(t *testing.T, timeout time.Duration) {
+	t.Helper()
+
+	saved := rangeRequestTimeout
+	rangeRequestTimeout = timeout
+
+	t.Cleanup(func() { rangeRequestTimeout = saved })
+}
+
+// readaheadTestIPA is an IPA laid out as a big app's is: thousands of files,
+// a nested bundle's Info.plist, the main app's Info.plist far from the end
+// (its executable after it), and the central directory last. It returns the
+// IPA and the size of its central directory.
+func readaheadTestIPA(t *testing.T, files int) ([]byte, int64) {
+	t.Helper()
+
+	buffer := new(bytes.Buffer)
+	writer := zip.NewWriter(buffer)
+
+	add := func(name string, method uint16, data []byte) {
+		file, err := writer.CreateHeader(&zip.FileHeader{Name: name, Method: method, Modified: time.Date(2020, 1, 1, 0, 0, 0, 0, time.UTC)})
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		if _, err := file.Write(data); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	infoPlist := func(version string) []byte {
+		data, err := plist.Marshal(map[string]interface{}{
+			"CFBundleExecutable":         "Sample",
+			"CFBundleShortVersionString": version,
+			"releaseDate":                "2024-04-02T12:00:00Z",
+		}, plist.BinaryFormat)
+		if err != nil {
+			t.Fatal(err)
+		}
+
+		return data
+	}
+
+	small := randomBytes(16, 0)
+	for i := range files / 2 {
+		add(fmt.Sprintf("Payload/Sample.app/Assets.bundle/Images/%06d/image-with-a-long-name@3x.png", i), zip.Store, small)
+	}
+
+	add("Payload/Sample.app/Frameworks/Nested.framework/Info.plist", zip.Deflate, infoPlist("9.9.9"))
+	add("Payload/Sample.app/Info.plist", zip.Deflate, infoPlist("4.5.6"))
+	add("Payload/Sample.app/Sample", zip.Store, randomBytes(3*rangeBlockSize, 1))
+
+	for i := range files - files/2 {
+		add(fmt.Sprintf("Payload/Sample.app/Frameworks/Nested.framework/Resources/%06d.lproj/Localizable.strings", i), zip.Store, small)
+	}
+
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	data := buffer.Bytes()
+	// The end of central directory record, with no comment: the directory's
+	// size is at 12.
+	return data, int64(binary.LittleEndian.Uint32(data[len(data)-22+12:]))
+}
