+func TestPartialZipReadaheadReadAtIsByteExact(t *testing.T) {
+	// The tail starts partway through the third block, so that block is short.
+	data := randomBytes(3*rangeBlockSize+rangeTailSize/2+123, 2)
+	server := newRangeServer(t, data, nil)
+
+	reader, size, err := newHTTPRangeReaderAt(newDownloadTestClient(), server.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if size != int64(len(data)) {
+		t.Fatalf("size = %d, want %d", size, len(data))
+	}
+
+	tailStart := size - rangeTailSize
+
+	for _, read := range []struct {
+		name   string
+		off, n int64
+		want   int64
+		eof    bool
+	}{
+		{name: "within a block", off: 10, n: 100, want: 100},
+		{name: "across a block boundary", off: rangeBlockSize - 10, n: 20, want: 20},
+		{name: "across two block boundaries", off: rangeBlockSize - 1, n: rangeBlockSize + 2, want: rangeBlockSize + 2},
+		{name: "the short block's last byte", off: tailStart - 1, n: 1, want: 1},
+		{name: "across the start of the tail", off: tailStart - 7, n: 14, want: 14},
+		{name: "up to the end exactly", off: size - 100, n: 100, want: 100},
+		{name: "the last byte", off: size - 1, n: 1, want: 1},
+		{name: "past the end", off: size - 3, n: 10, want: 3, eof: true},
+		{name: "at the end", off: size, n: 1, want: 0, eof: true},
+		{name: "the whole file", off: 0, n: size, want: size},
+		{name: "more than the whole file", off: 0, n: size + 5, want: size, eof: true},
+	} {
+		t.Run(read.name, func(t *testing.T) {
+			p := make([]byte, read.n)
+
+			n, err := reader.ReadAt(p, read.off)
+			if int64(n) != read.want {
+				t.Fatalf("n = %d, want %d", n, read.want)
+			}
+
+			if read.eof && err != io.EOF {
+				t.Fatalf("err = %v, want io.EOF", err)
+			}
+
+			if !read.eof && err != nil {
+				t.Fatalf("err = %v", err)
+			}
+
+			if !bytes.Equal(p[:n], data[read.off:read.off+int64(n)]) {
+				t.Fatal("the bytes read are not the file's")
+			}
+		})
+	}
+
+	if _, err := reader.ReadAt(make([]byte, 1), -1); err == nil {
+		t.Fatal("a negative offset was read")
+	}
+
+	// The size, the tail and the three blocks before it, each fetched once,
+	// and no byte of the file twice.
+	if requests, sent := server.requests.Load(), server.sent.Load(); requests != 5 || sent != size+1 {
+		t.Fatalf("%d requests sending %d bytes, want 5 sending %d", requests, sent, size+1)
+	}
+}
