+			requests: 2,
+			says:     "invalid content range",
+		},
+		{
+			name: "another size",
+			answer: func(w http.ResponseWriter, start, end int) {
+				w.Header().Set("Content-Range", fmt.Sprintf("bytes %d-%d/%d", start, end, len(data)+1))
+				w.WriteHeader(http.StatusPartialContent)
+				_, _ = w.Write(data[start : end+1])
+			},
+			requests: 2,
+			says:     "invalid content range",
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			server := newRangeServer(t, data, func(n int64, w http.ResponseWriter, r *http.Request) bool {
+				if n == 1 {
+					return false
+				}
+
+				start, end, err := testRangeBounds(r.Header.Get("Range"), len(data))
+				if err != nil {
+					t.Error(err)
+				}
+
+				test.answer(w, start, end)
+
+				return true
+			})
+
+			reader, _, err := newHTTPRangeReaderAt(newDownloadTestClient(), server.URL)
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			n, err := reader.ReadAt(make([]byte, 10), 0)
+			if n != 0 || err == nil || err == io.EOF || !strings.Contains(err.Error(), test.says) {
+				t.Fatalf("ReadAt = %d, %v", n, err)
+			}
+
+			if requests := server.requests.Load(); requests != test.requests {
+				t.Fatalf("%d requests, want %d", requests, test.requests)
+			}
+		})
+	}
+}
+
+func TestPartialZipReadaheadTimesOutAndRetriesAStalledRequest(t *testing.T) {
+	withRangeRequestTimeout(t, 300*time.Millisecond)
+
+	data := randomBytes(2*rangeBlockSize+rangeTailSize, 6)
+	stallBody := func(w http.ResponseWriter, r *http.Request) {
+		start, end, _ := testRangeBounds(r.Header.Get("Range"), len(data))
+		w.Header().Set("Content-Range", fmt.Sprintf("bytes %d-%d/%d", start, end, len(data)))
+		w.Header().Set("Content-Length", strconv.Itoa(end-start+1))
+		w.WriteHeader(http.StatusPartialContent)
+		_, _ = w.Write(data[start : start+(end-start)/2])
+		w.(http.Flusher).Flush()
+		stall(w, r)
+	}
+
+	for _, test := range []struct {
+		name     string
+		stalls   func(n int64) bool
+		answer   func(w http.ResponseWriter, r *http.Request)
+		requests int64
+		fails    bool
+	}{
+		{name: "the size, once", stalls: func(n int64) bool { return n == 1 }, answer: stall, requests: 3},
+		{name: "a block, once", stalls: func(n int64) bool { return n == 2 }, answer: stall, requests: 3},
+		{name: "a block's body, once", stalls: func(n int64) bool { return n == 2 }, answer: stallBody, requests: 3},
+		{name: "a block, every time", stalls: func(n int64) bool { return n >= 2 }, answer: stall, requests: 3, fails: true},
+		{name: "a block's body, every time", stalls: func(n int64) bool { return n >= 2 }, answer: stallBody, requests: 3, fails: true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			server := newRangeServer(t, data, func(n int64, w http.ResponseWriter, r *http.Request) bool {
+				if !test.stalls(n) {
+					return false
+				}
+
+				test.answer(w, r)
+
+				return true
+			})
+
+			began := time.Now()
+
+			reader, _, err := newHTTPRangeReaderAt(newDownloadTestClient(), server.URL)
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			p := make([]byte, 10)
+			n, err := reader.ReadAt(p, 0)
+
+			took := time.Since(began)
+			if took < rangeRequestTimeout || took > 4*rangeRequestTimeout+2*time.Second {
+				t.Fatalf("took %v, with a %v timeout", took, rangeRequestTimeout)
+			}
+
+			if test.fails {
+				if n != 0 || !errors.Is(err, context.DeadlineExceeded) {
+					t.Fatalf("ReadAt = %d, %v", n, err)
+				}
+			} else if err != nil || !bytes.Equal(p, data[:10]) {
+				t.Fatalf("ReadAt = %d, %v", n, err)
+			}
+
+			if requests := server.requests.Load(); requests != test.requests {
+				t.Fatalf("%d requests, want %d", requests, test.requests)
+			}
+		})
+	}
+}
