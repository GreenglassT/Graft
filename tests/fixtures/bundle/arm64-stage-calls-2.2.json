{
 "_build_env": {
  "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
  "HOME": "$HOME",
  "TMPDIR": "$TMPDIR",
  "LANG": "C",
  "MACOSX_DEPLOYMENT_TARGET": "14.0"
 },
 "openssl_repoint_plan": [
  [
   "/opt/homebrew/opt/openssl@3/lib/libssl.3.dylib",
   "@executable_path/../../Frameworks/libssl.3.dylib"
  ],
  [
   "/opt/homebrew/opt/openssl@3/lib/libcrypto.3.dylib",
   "@executable_path/../../Frameworks/libcrypto.3.dylib"
  ]
 ],
 "install_locked": [
  [
   "/py/bin/python3.13",
   "-I",
   "-m",
   "pip",
   "install",
   "--disable-pip-version-check",
   "--retries",
   "10",
   "--timeout",
   "60",
   "--cache-dir",
   "$TMP/cache/pip",
   "--dry-run",
   "--ignore-installed",
   "--report",
   "$TMP/plan.json",
   "--platform",
   "macosx_14_0_arm64",
   "--python-version",
   "3.13",
   "--implementation",
   "cp",
   "--abi",
   "cp313",
   "--only-binary=:all:",
   "--require-hashes",
   "--no-deps",
   "-r",
   "$REPO/bundle/requirements.lock"
  ],
  [
   "/py/bin/python3.13",
   "-I",
   "-m",
   "pip",
   "download",
   "--disable-pip-version-check",
   "--retries",
   "10",
   "--timeout",
   "60",
   "--cache-dir",
   "$TMP/cache/pip",
   "-d",
   "$TMP/pip/wheels",
   "--platform",
   "macosx_14_0_arm64",
   "--python-version",
   "3.13",
   "--implementation",
   "cp",
   "--abi",
   "cp313",
   "--only-binary=:all:",
   "--require-hashes",
   "--no-deps",
   "-r",
   "$REPO/bundle/requirements.lock"
  ],
  [
   "/py/bin/python3.13",
   "-I",
   "-m",
   "pip",
   "install",
   "--disable-pip-version-check",
   "--retries",
   "10",
   "--timeout",
   "60",
   "--no-cache-dir",
   "--no-warn-script-location",
   "--no-compile",
   "--no-index",
   "--find-links",
   "$TMP/pip/wheels",
   "--only-binary=:all:",
   "--require-hashes",
   "--no-deps",
   "--report",
   "$TMP/pip/installed.json",
   "-r",
   "$REPO/bundle/requirements.lock"
  ]
 ],
 "stage_order": [
  "stage_python",
  "cyan_frameworks",
  "build_openssl",
  "fetch",
  "extract",
  "_the_binary",
  "stage_openssl_and_zsign",
  "vendored_licences",
  "stage_ipatool",
  "stage_unfairplay",
  "python_static_licences",
  "lock_hashes",
  "rust_crate_licences",
  "binary_crate_licences",
  "build_cyan_helpers",
  "fetch",
  "cyan_original_hashes",
  "stage_cyan_helpers",
  "build_launchers",
  "stage_preferences_stub",
  "prune_unlinked_libpython",
  "thin_to_arm64",
  "prune_foreign_rpaths",
  "collect_licenses",
  "crate_notice_problems",
  "write_components",
  "check_no_build_paths",
  "signed_machos",
  "write_entitlements_list"
 ]
}
